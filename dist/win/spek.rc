// Keep the application manifest in one place. wxWidgets' own manifest is
// disabled below so that it cannot conflict with the explicit PerMonitorV2
// declaration in src/app.manifest.
#define wxUSE_NO_MANIFEST 1
#include <wx/msw/wx.rc>

// Embed the same manifest with MSVC, MinGW and Clang resource compilers.
// Keeping it in this resource script avoids a second RT_MANIFEST resource
// being generated by the Visual Studio manifest tool.
1 RT_MANIFEST "app.manifest"

aaaa ICON "spek.ico"
help ICON "help.ico"
open ICON "open.ico"
save ICON "save.ico"
close ICON "close.ico"
