// Keep the application manifest in one place. wxWidgets' own manifest is
// disabled below so that it cannot conflict with the explicit PerMonitorV2
// declaration in src/app.manifest.
#define wxUSE_NO_MANIFEST 1
#include <wx/msw/wx.rc>

// MSVC and clang-cl pass src/app.manifest to the manifest tool from CMake.
// MinGW and other resource-compiler toolchains embed it here instead.
#ifndef SPEK_EXTERNAL_MANIFEST
1 RT_MANIFEST "app.manifest"
#endif

aaaa ICON "spek.ico"
help ICON "help.ico"
open ICON "open.ico"
save ICON "save.ico"
close ICON "close.ico"
