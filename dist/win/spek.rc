// Keep the application manifest in one place. wxWidgets' own manifest is
// disabled below so that it cannot conflict with the explicit PerMonitorV2
// declaration in src/app.manifest.
#define wxUSE_NO_MANIFEST 1
#include <wx/msw/wx.rc>

// Visual Studio/MSVC receives src/app.manifest as a manifest input from
// CMake. MinGW and other resource-compiler toolchains embed it here instead.
#ifndef _MSC_VER
1 RT_MANIFEST "app.manifest"
#endif

aaaa ICON "spek.ico"
help ICON "help.ico"
open ICON "open.ico"
save ICON "save.ico"
close ICON "close.ico"
