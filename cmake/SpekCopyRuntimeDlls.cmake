# Copies the DLLs of the dependencies which the target links against next to
# its executable, so that the binaries of the build directory can be run
# straight away.
#
# The list is empty when the dependencies are linked statically, when they
# are found through pkg-config instead of imported targets, or when the
# toolchain copies the DLLs on its own (vcpkg does), and `cmake -E
# copy_if_different` fails when it is given no file to copy. For that reason
# the copy happens in a generated script which skips the empty lists.
function(spek_copy_runtime_dlls target)
    if(NOT WIN32)
        return()
    endif()

    set(script "${CMAKE_CURRENT_BINARY_DIR}/${target}-copy-dlls-$<CONFIG>.cmake")
    file(GENERATE
        OUTPUT "${script}"
        CONTENT
"# Generated by SpekCopyRuntimeDlls.cmake, do not edit.
if(NOT \"$<TARGET_RUNTIME_DLLS:${target}>\" STREQUAL \"\")
    file(COPY $<TARGET_RUNTIME_DLLS:${target}> DESTINATION \"$<TARGET_FILE_DIR:${target}>\")
endif()
"
    )

    add_custom_command(TARGET "${target}" POST_BUILD
        COMMAND "${CMAKE_COMMAND}" -P "${script}"
        COMMENT "Copying the DLLs next to $<TARGET_FILE_NAME:${target}>"
        VERBATIM
    )
endfunction()
